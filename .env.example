# ─────────────────────────────────────────────────────────
# retail_gcp environment variables
# Copy to .env and fill in your values
# NEVER commit .env to GitHub
# ─────────────────────────────────────────────────────────

# Your Google Cloud project ID
# Find it at: console.cloud.google.com → project selector
GCP_PROJECT_ID=your-project-id-here

# BigQuery location — use EU or US (EU recommended for Kenya → GDPR alignment)
BQ_LOCATION=EU

# BigQuery dataset names (leave as-is unless you want custom names)
BQ_DATASET_RAW=retail_raw
BQ_DATASET_STAGING=retail_staging
BQ_DATASET_MARTS=retail_marts

# Google Sheet ID
# From URL: https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# dbt target environment: dev or prod
DBT_TARGET=dev
